# Obsidian per-machine workspace state (not part of vault content)
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json
**/.obsidian/workspace.json.bak
**/.obsidian/cache

# Obsidian sync-conflict files (from Syncthing / iCloud / etc.)
**/.obsidian/*.sync-conflict-*.json

# Obsidian trash — user-managed, not source of truth
**/.trash/

# OS cruft
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
